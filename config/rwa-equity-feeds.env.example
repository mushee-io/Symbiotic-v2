# Server-side ONLY. Set a JSON array with 2+ independent licensed HTTPS feeds.
# Do not put paid API tokens in frontend code. Each provider must emit an
# Ed25519-signed observation matching the exact canonical payload in
# lib/rwa-equity-oracle.ts. A TradingView embed is not a settlement oracle.
#
# Example structure (placeholder values intentionally unusable):
# SYMBIOTIC_EQUITY_FEEDS_JSON=[{"id":"source-a","url":"https://feed-a.example.com/equities/{ticker}","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"},{"id":"source-b","url":"https://feed-b.example.com/equities/{ticker}","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}]
#
# Cardano Preprod UTxO verifier:
SYMBIOTIC_RWA_BLOCKFROST_PROJECT_ID=
